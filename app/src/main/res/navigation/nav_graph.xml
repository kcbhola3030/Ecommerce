<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.ecommerce.view.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_subcategory"
            app:destination="@id/subCategoryFragment"/>
        <action
            android:id="@+id/action_home_to_product_detail"
            app:destination="@id/productDetailFragment"/>

    </fragment>


    <fragment
        android:id="@+id/subCategoryFragment"
        android:name="com.example.ecommerce.view.SubCategoryFragment"
        android:label="SubCategory"
        tools:layout="@layout/fragment_sub_category">

        <argument
            android:name="categoryId"
            app:argType="string"/>
        <argument
            android:name="categoryName"
            app:argType="string"/>

        <action
            android:id="@+id/action_subcategory_to_detail"
            app:destination="@id/productDetailFragment"/>

    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.ecommerce.view.ProductDetailFragment"
        android:label="Details"
        tools:layout="@layout/fragment_product_detail">

        <argument
            android:name="productId"
            app:argType="string"/>
        <argument
            android:name="productName"
            app:argType="string"/>

    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.ecommerce.view.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart">

        <action
            android:id="@+id/action_cart_to_checkout"
            app:destination="@id/checkoutFragment"/>

    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.example.ecommerce.view.checkout.CheckoutFragment"
        android:label="Checkout"
        tools:layout="@layout/fragment_checkout">

        <action
            android:id="@+id/action_checkout_to_confirmed"
            app:destination="@id/orderConfirmedFragment"/>

    </fragment>

    <fragment
        android:id="@+id/orderConfirmedFragment"
        android:name="com.example.ecommerce.view.OrderConfirmedFragment"
        android:label="Order Confirmed"
        tools:layout="@layout/fragment_order_confirmed">

        <argument
            android:name="orderId"
            app:argType="string"/>

    </fragment>

</navigation>